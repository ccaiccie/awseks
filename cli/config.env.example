# Copy to cli/config.env. That file is gitignored because it will contain your CIDR.
# Do not put access keys in this file. Configure the AWS CLI with a profile or IAM Identity Center.

AWS_REGION=us-west-2
CLUSTER_NAME=awseks-cli-lab
OWNER=student
KUBERNETES_VERSION=1.36

VPC_CIDR=10.0.0.0/16
SERVICE_IPV4_CIDR=172.20.0.0/16
AZ_COUNT=2

# single: one NAT gateway. per_az: one NAT per AZ. none: no NAT, interface endpoints are forced on.
NAT_STRATEGY=single
ENABLE_INTERFACE_ENDPOINTS=false

# Private API access is always enabled by the scripts.
# Set ENABLE_PUBLIC_ENDPOINT=true only with your own /32. 0.0.0.0/0 is rejected.
# Discover it with: curl -fsS https://checkip.amazonaws.com
ENABLE_PUBLIC_ENDPOINT=false
PUBLIC_ACCESS_CIDRS=

NODE_INSTANCE_TYPE=t3.medium
NODE_AMI_TYPE=AL2023_x86_64_STANDARD
NODE_CAPACITY_TYPE=ON_DEMAND
NODE_MIN=2
NODE_DESIRED=2
NODE_MAX=3
NODE_DISK_GIB=20

DELETION_PROTECTION=true
BOOTSTRAP_CLUSTER_CREATOR_ADMIN=true
