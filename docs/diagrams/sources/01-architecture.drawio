<mxfile host="app.diagrams.net" type="device"><diagram id="01-architecture" name="Standard EKS lab layout"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#31415a;fillColor=#E8F2FC;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="920" height="520" as="geometry"/></mxCell><mxCell id="3" value="VPC 10.0.0.0/16  ·  DNS hostnames on  ·  tagged awseks-practice" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#31415a;fillColor=#E8F2FC;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="106" width="860" height="36" as="geometry"/></mxCell><mxCell id="4" value="Public subnets&#10;Internet gateway default route&#10;NAT gateway lives here&#10;Load balancer ENIs can live here" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#31415a;fillColor=#E5F6E8;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="166" width="400" height="160" as="geometry"/></mxCell><mxCell id="5" value="Private subnets, two or three AZs&#10;No public IPv4 on nodes&#10;Control plane ENIs and worker nodes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#31415a;fillColor=#FFF4E0;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="166" width="430" height="160" as="geometry"/></mxCell><mxCell id="6" value="EKS API&#10;private endpoint on&#10;public endpoint optional" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#31415a;fillColor=#F3E8FF;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="366" width="250" height="90" as="geometry"/></mxCell><mxCell id="7" value="Managed node group&#10;AL2023, no SSH key&#10;IMDSv2 hop limit 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#31415a;fillColor=#E7F7F7;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="366" width="250" height="90" as="geometry"/></mxCell><mxCell id="8" value="Pods get VPC IPs&#10;from the VPC CNI&#10;Service CIDR is not a subnet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#31415a;fillColor=#E7F7F7;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="366" width="270" height="90" as="geometry"/></mxCell><mxCell id="9" value="S3 gateway endpoint is on by default. Interface endpoints are optional and cost money. One NAT is cheaper and fails with that AZ." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#31415a;fillColor=#F7F7F5;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="486" width="830" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
