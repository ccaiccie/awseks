# Copy to config.env. Values are intentionally NOT real account/client values.
export AWS_REGION=us-west-2
export EXPECTED_ACCOUNT_ID=REPLACE_12_DIGIT_ACCOUNT
export STACK=eksclass-cli-student01
export K8S_VERSION=1.36
# IAM ROLE ARN, not arn:...:sts::...:assumed-role/... session ARN.
export ADMIN_ROLE_ARN=arn:aws:iam::REPLACE_12_DIGIT_ACCOUNT:role/REPLACE_LAB_OPERATOR_ROLE
export ADMIN_PUBLIC_CIDR=REPLACE_ACTUAL_PUBLIC_EGRESS_IPV4/32
export INSTANCE_TYPE=m6i.large
export NODE_DESIRED=2
export COST_ACK=NO
# Change to I_ACCEPT_BILLABLE_SANDBOX only after reading COSTS.md.
# Kubernetes manifests use registry.k8s.io/e2e-test-images/agnhost:2.53.
# For strict reproducibility, supply a reviewed digest below; scripts require it.
export APP_IMAGE=REPLACE_REVIEWED_REGISTRY_IMAGE_AT_SHA256
export AWSCLI_IMAGE=REPLACE_REVIEWED_PUBLIC_ECR_AWSCLI_IMAGE_AT_SHA256
# Set after reviewing a chart whose appVersion is v3.6.2 (see 06 script).
export LBC_CHART_VERSION=3.6.2
export DEBUG_IMAGE=REPLACE_REVIEWED_BUSYBOX_IMAGE_AT_SHA256
