{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EKS authored flow blueprint (source phase)",
  "type": "object",
  "required": ["schemaVersion", "date", "addressLedger", "assumptions", "scenarios"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "date": {"type": "string"},
    "addressLedger": {"type": "object"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "scenarios": {"type": "array", "minItems": 29, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "hop": {
      "type": "object", "required": ["from", "to", "sourcePort", "targetPort", "waypoints", "envelope", "hideTokenDuringNodeProcessing"],
      "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "waypoints": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point"}}, "envelope": {"const": "none"}, "hideTokenDuringNodeProcessing": {"const": true}}
    },
    "processing": {
      "type": "object", "required": ["actor", "decisionEngine", "packetBefore", "packetAfter", "routeLookup"],
      "properties": {"actor": {"type": "string"}, "decisionEngine": {"type": "string"}, "routeLookup": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["owner", "association", "lookupDestination", "candidates", "winner", "reason"]}]}}
    },
    "scenario": {
      "type": "object", "required": ["id", "title", "kind", "track", "illustrative", "nodes", "forwardVisits", "returnVisits", "forwardProcessing", "returnProcessing", "hopSegments", "contextBand"],
      "properties": {
        "id": {"type": "string", "pattern": "^F[0-9]{2}$"}, "illustrative": {"const": true},
        "nodes": {"type": "array", "minItems": 2},
        "forwardVisits": {"type": "array", "items": {"type": "string"}}, "returnVisits": {"type": "array", "items": {"type": "string"}},
        "forwardProcessing": {"type": "array", "items": {"$ref": "#/$defs/processing"}}, "returnProcessing": {"type": "array", "items": {"$ref": "#/$defs/processing"}},
        "hopSegments": {"type": "object", "required": ["forward", "return"], "properties": {"forward": {"type": "array", "items": {"$ref": "#/$defs/hop"}}, "return": {"type": "array", "items": {"$ref": "#/$defs/hop"}}}}
      }
    }
  }
}
